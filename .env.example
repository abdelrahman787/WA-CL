# .env.example - OpenWA Configuration
# Copy this file to .env and adjust values

# =================================
# Application
# =================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# =================================
# Database (Minimal Profile: SQLite)
# =================================
DATABASE_TYPE=sqlite
DATABASE_SQLITE_PATH=./data/openwa.db

# For production, use PostgreSQL:
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://openwa:openwa@localhost:5432/openwa

# =================================
# Storage
# =================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./media

# =================================
# Cache (Minimal Profile: In-memory)
# =================================
CACHE_TYPE=memory

# For production, use Redis:
# CACHE_TYPE=redis
# REDIS_URL=redis://localhost:6379

# =================================
# Security
# =================================
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=dev-encryption-key-change-in-production
API_KEY_MASTER=dev-master-key-change-in-production

# =================================
# Session
# =================================
SESSION_DATA_PATH=./.wwebjs_auth
MAX_SESSIONS=3

# =================================
# Engine
# =================================
ENGINE_TYPE=whatsapp-web.js
PUPPETEER_HEADLESS=true

# =================================
# Development
# =================================
SWAGGER_ENABLED=true
